rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Administrador atual do projeto. Mantido para o painel de validações e
    // para a limpeza controlada de históricos, sem permissão para fabricar XP.
    function isProjectOwner() {
      return signedIn() &&
        request.auth.uid == 'AyqcaBcvGKdm0sVWonLVPv4MAjP2';
    }

    function isNonEmptyString(value, maxSize) {
      return value is string && value == value.trim() &&
        value.size() > 0 && value.size() <= maxSize;
    }

    function isOptionalEmail(value) {
      return value == null ||
        (value is string && value.size() <= 254);
    }

    function isOptionalPhotoUrl(data) {
      return !data.keys().hasAny(['photoURL']) ||
        (data.photoURL is string && data.photoURL.size() <= 4096);
    }

    function isNumber(value) {
      return value is int || value is float;
    }

    function isBaseRoute(routeId) {
      return routeId in ['tecnologia', 'religiosa', 'cafe', 'gastronomia'];
    }

    function baseRouteHasPlace(routeId, placeId) {
      return (
        routeId == 'tecnologia' &&
        placeId in ['inatel', 'fai', 'ete', 'incubadora-municipal']
      ) || (
        routeId == 'religiosa' &&
        placeId in [
          'capela-santa-luzia',
          'capela-santo-antonio',
          'sao-benedito',
          'igreja-batista-universitaria',
          'matriz-santa-rita',
          'igreja-presbiteriana',
          'pibave',
          'assembleia-de-deus-esperanca'
        ]
      ) || (
        routeId == 'cafe' &&
        placeId in [
          'moca-cafeteria',
          'grandpa-joels',
          'barao-cafeteria',
          'nano-coffee-lab',
          'melhor-da-terra-cafeteria'
        ]
      ) || (
        routeId == 'gastronomia' &&
        placeId in [
          'braseiro',
          'brazza',
          'casa-do-pi',
          'restaurante-vista-alegre',
          'bragas-bistro',
          'armazem-do-vale',
          'hart-grill',
          'restaurante-do-dimas',
          'casa-de-sinha',
          'restaurante-estancia',
          'elite-mineira',
          'dija-gastronomia',
          'mimmas'
        ]
      );
    }

    function validBasePlaceTitle(placeId, placeTitle) {
      return (placeId == 'inatel' && placeTitle == 'INATEL') ||
        (placeId == 'fai' && placeTitle == 'FAI') ||
        (placeId == 'ete' && placeTitle == 'ETE FMC') ||
        (placeId == 'incubadora-municipal' && placeTitle == 'Incubadora Municipal') ||
        (placeId == 'capela-santa-luzia' && placeTitle == 'Capela Santa Luzia') ||
        (placeId == 'capela-santo-antonio' && placeTitle == 'Capela Santo Antônio') ||
        (placeId == 'sao-benedito' && placeTitle == 'São Benedito') ||
        (placeId == 'igreja-batista-universitaria' && placeTitle == 'Igreja Batista Universitária') ||
        (placeId == 'matriz-santa-rita' && placeTitle == 'Matriz da Paróquia Santa Rita') ||
        (placeId == 'igreja-presbiteriana' && placeTitle == 'Igreja Presbiteriana') ||
        (placeId == 'pibave' && placeTitle == 'PIBAVE') ||
        (placeId == 'assembleia-de-deus-esperanca' && placeTitle == 'Assembleia de Deus Esperança') ||
        (placeId == 'moca-cafeteria' && placeTitle == 'Moca Cafeteria') ||
        (placeId == 'grandpa-joels' && placeTitle == "Grandpa Joel's Coffee Shop") ||
        (placeId == 'barao-cafeteria' && placeTitle == 'Barão Cafeteria') ||
        (placeId == 'nano-coffee-lab' && placeTitle == 'Nano Coffee Lab') ||
        (placeId == 'melhor-da-terra-cafeteria' && placeTitle == 'Melhor da Terra Cafeteria') ||
        (placeId == 'braseiro' && placeTitle == 'Braseiro') ||
        (placeId == 'brazza' && placeTitle == 'Brazza') ||
        (placeId == 'casa-do-pi' && placeTitle == 'Casa do Pi') ||
        (placeId == 'restaurante-vista-alegre' && placeTitle == 'Restaurante Vista Alegre') ||
        (placeId == 'bragas-bistro' && placeTitle == "Braga's Bistro e Burguer") ||
        (placeId == 'armazem-do-vale' && placeTitle == 'Armazém do Vale') ||
        (placeId == 'hart-grill' && placeTitle == 'Restaurante Hart Grill') ||
        (placeId == 'restaurante-do-dimas' && placeTitle == 'Restaurante do Dimas') ||
        (placeId == 'casa-de-sinha' && placeTitle == 'Casa de Sinhá') ||
        (placeId == 'restaurante-estancia' && placeTitle == 'Restaurante Estância') ||
        (placeId == 'elite-mineira' && placeTitle == 'Elite Mineira') ||
        (placeId == 'dija-gastronomia' && placeTitle == 'Dijá Gastronomia') ||
        (placeId == 'mimmas' && placeTitle == "Mimma's");
    }

    function isCustomRouteId(routeId) {
      return routeId is string &&
        routeId.matches('^personalizada-[A-Za-z0-9]{20}$');
    }

    function customRouteDocumentId(routeId) {
      return routeId.replace('^personalizada-', '');
    }

    function validCustomRoutePlace(routeId, placeId, placeTitle) {
      let routeDocumentId = customRouteDocumentId(routeId);
      let routePath = /databases/$(database)/documents/routes/$(routeDocumentId);

      return isCustomRouteId(routeId) &&
        placeId == routeDocumentId + '-principal' &&
        exists(routePath) &&
        get(routePath).data.nome == placeTitle &&
        get(routePath).data.pontos is list &&
        get(routePath).data.pontos.size() == 1 &&
        get(routePath).data.pontos[0].id == placeId;
    }

    function validRoutePlace(routeId, placeId, placeTitle) {
      return (
        isBaseRoute(routeId) &&
        baseRouteHasPlace(routeId, placeId) &&
        validBasePlaceTitle(placeId, placeTitle)
      ) || validCustomRoutePlace(routeId, placeId, placeTitle);
    }

    function validBaseRewardMetadata(data) {
      return (
        data.routeId == 'tecnologia' &&
        data.routeName == 'Rota da Tecnologia' &&
        data.prize == 'Selo Explorador Tech'
      ) || (
        data.routeId == 'religiosa' &&
        data.routeName == 'Rota Religiosa' &&
        data.prize == 'Selo Caminho da Fé'
      ) || (
        data.routeId == 'cafe' &&
        data.routeName == 'Rota do Café' &&
        data.prize == 'Cupom Café Local'
      ) || (
        data.routeId == 'gastronomia' &&
        data.routeName == 'Rota Gastronômica' &&
        data.prize == 'Selo Sabores de Santa Rita'
      );
    }

    function validCustomRewardMetadata(data) {
      let routeDocumentId = customRouteDocumentId(data.routeId);
      let routePath = /databases/$(database)/documents/routes/$(routeDocumentId);

      return isCustomRouteId(data.routeId) &&
        exists(routePath) &&
        get(routePath).data.nome == data.routeName &&
        get(routePath).data.premio == data.prize;
    }

    function rankingPoints(data) {
      return data.get('points', data.get('scanCount', 0) * 100);
    }

    function rankingPlaces(data) {
      return data.get('placesVisited', data.get('scanCount', 0));
    }

    function rankingRoutes(data) {
      return data.get('routesCompleted', 0);
    }

    function validRankingIdentity(userId, data) {
      return isOwner(userId) && data.userId == userId &&
        isNonEmptyString(data.userName, 120) &&
        isOptionalEmail(data.userEmail) &&
        isOptionalPhotoUrl(data);
    }

    function rankingEventAfter(userId, eventId) {
      return getAfter(
        /databases/$(database)/documents/ranking/$(userId)/xpEvents/$(eventId)
      ).data;
    }

    function validRankingCreate(userId) {
      let data = request.resource.data;
      let points = data.points;
      let places = data.placesVisited;
      let routes = data.routesCompleted;
      let scans = data.get('scanCount', 0);
      let eventId = data.lastXpEventId;
      let event = rankingEventAfter(userId, eventId);

      return data.keys().hasAll([
          'userId',
          'userName',
          'userEmail',
          'points',
          'placesVisited',
          'routesCompleted',
          'lastXpEventId',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'userName',
          'userEmail',
          'photoURL',
          'points',
          'placesVisited',
          'routesCompleted',
          'scanCount',
          'lastScannedAt',
          'lastXpEventId',
          'updatedAt'
        ]) &&
        points is int && points >= 0 &&
        places is int && places >= 0 &&
        routes is int && routes >= 0 &&
        scans is int && scans >= 0 &&
        eventId is string && eventId == event.type + '_' + event.targetId &&
        event.userId == userId &&
        event.pointsBefore == 0 && event.pointsAfter == points &&
        event.placesBefore == 0 && event.placesAfter == places &&
        event.routesBefore == 0 && event.routesAfter == routes &&
        event.scanCountBefore == 0 && event.scanCountAfter == scans &&
        data.updatedAt == request.time &&
        (
          (
            points == 100 && places == 1 && routes == 0 && scans == 1 &&
            data.keys().hasAll(['lastScannedAt']) &&
            data.lastScannedAt == request.time
          ) || (
            points == 20 && places == 0 && routes == 0 && scans == 0 &&
            !data.keys().hasAny(['lastScannedAt', 'scanCount'])
          ) || (
            points == 500 && places == 0 && routes == 1 && scans == 0 &&
            !data.keys().hasAny(['lastScannedAt', 'scanCount'])
          )
        );
    }

    function validRankingScoreChange(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let pointDelta = data.points - rankingPoints(resource.data);
      let placeDelta = rankingPlaces(data) - rankingPlaces(resource.data);
      let routeDelta = rankingRoutes(data) - rankingRoutes(resource.data);
      let scanDelta = data.get('scanCount', 0) - resource.data.get('scanCount', 0);
      let eventId = data.lastXpEventId;
      let event = rankingEventAfter(userId, eventId);

      return data.keys().hasAll([
          'userId',
          'userName',
          'userEmail',
          'points',
          'placesVisited',
          'routesCompleted',
          'lastXpEventId',
          'updatedAt'
        ]) &&
        data.points is int && data.points >= 0 &&
        rankingPlaces(data) is int && rankingPlaces(data) >= 0 &&
        rankingRoutes(data) is int && rankingRoutes(data) >= 0 &&
        data.get('scanCount', 0) is int && data.get('scanCount', 0) >= 0 &&
        eventId is string && eventId == event.type + '_' + event.targetId &&
        event.userId == userId &&
        event.pointsBefore == rankingPoints(resource.data) &&
        event.pointsAfter == data.points &&
        event.placesBefore == rankingPlaces(resource.data) &&
        event.placesAfter == rankingPlaces(data) &&
        event.routesBefore == rankingRoutes(resource.data) &&
        event.routesAfter == rankingRoutes(data) &&
        event.scanCountBefore == resource.data.get('scanCount', 0) &&
        event.scanCountAfter == data.get('scanCount', 0) &&
        data.updatedAt == request.time &&
        (
          (
            pointDelta == 100 && placeDelta == 1 &&
            routeDelta == 0 && scanDelta == 1 &&
            data.lastScannedAt == request.time
          ) || (
            pointDelta == 20 && placeDelta == 0 &&
            routeDelta == 0 && scanDelta == 0 &&
            !changed.hasAny(['lastScannedAt'])
          ) || (
            pointDelta == 500 && placeDelta == 0 &&
            routeDelta == 1 && scanDelta == 0 &&
            !changed.hasAny(['lastScannedAt'])
          )
        ) &&
        changed.hasOnly([
          'userId',
          'userName',
          'userEmail',
          'photoURL',
          'points',
          'placesVisited',
          'routesCompleted',
          'scanCount',
          'lastScannedAt',
          'lastXpEventId',
          'updatedAt'
        ]);
    }

    function validRankingProfileChange() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();

      return data.userId == resource.data.userId &&
        isNonEmptyString(data.userName, 120) &&
        isOptionalEmail(data.userEmail) &&
        isOptionalPhotoUrl(data) &&
        data.updatedAt == request.time &&
        changed.hasOnly([
          'userId',
          'userName',
          'userEmail',
          'photoURL',
          'updatedAt'
        ]);
    }

    function sourceWasCreated(collectionName, userId, targetId, targetField) {
      let sourceId = userId + '_' + targetId;
      let sourcePath = /databases/$(database)/documents/$(collectionName)/$(sourceId);
      let source = getAfter(sourcePath).data;

      return !exists(sourcePath) &&
        source.userId == userId &&
        source.get(targetField, '') == targetId;
    }

    function xpSourceWasCreated(userId, event) {
      return (
        event.type == 'visita' &&
        sourceWasCreated('visits', userId, event.targetId, 'placeId')
      ) || (
        event.type == 'avaliacao' &&
        sourceWasCreated('ratings', userId, event.targetId, 'placeId')
      ) || (
        event.type == 'rotaCompleta' &&
        sourceWasCreated('rewards', userId, event.targetId, 'routeId')
      );
    }

    function validXpEvent(userId, eventId) {
      let event = request.resource.data;

      return event.keys().hasAll([
          'userId',
          'type',
          'targetId',
          'points',
          'pointsBefore',
          'pointsAfter',
          'placesBefore',
          'placesAfter',
          'routesBefore',
          'routesAfter',
          'scanCountBefore',
          'scanCountAfter',
          'createdAt'
        ]) &&
        event.keys().hasOnly([
          'userId',
          'type',
          'targetId',
          'points',
          'pointsBefore',
          'pointsAfter',
          'placesBefore',
          'placesAfter',
          'routesBefore',
          'routesAfter',
          'scanCountBefore',
          'scanCountAfter',
          'createdAt'
        ]) &&
        isOwner(userId) && event.userId == userId &&
        isNonEmptyString(event.targetId, 128) &&
        eventId == event.type + '_' + event.targetId &&
        event.points is int &&
        event.pointsBefore is int && event.pointsBefore >= 0 &&
        event.pointsAfter is int && event.pointsAfter >= 0 &&
        event.placesBefore is int && event.placesBefore >= 0 &&
        event.placesAfter is int && event.placesAfter >= 0 &&
        event.routesBefore is int && event.routesBefore >= 0 &&
        event.routesAfter is int && event.routesAfter >= 0 &&
        event.scanCountBefore is int && event.scanCountBefore >= 0 &&
        event.scanCountAfter is int && event.scanCountAfter >= 0 &&
        event.pointsAfter == event.pointsBefore + event.points &&
        event.createdAt == request.time &&
        (
          (
            event.type == 'visita' && event.points == 100 &&
            event.placesAfter == event.placesBefore + 1 &&
            event.routesAfter == event.routesBefore &&
            event.scanCountAfter == event.scanCountBefore + 1
          ) || (
            event.type == 'avaliacao' && event.points == 20 &&
            event.placesAfter == event.placesBefore &&
            event.routesAfter == event.routesBefore &&
            event.scanCountAfter == event.scanCountBefore
          ) || (
            event.type == 'rotaCompleta' && event.points == 500 &&
            event.placesAfter == event.placesBefore &&
            event.routesAfter == event.routesBefore + 1 &&
            event.scanCountAfter == event.scanCountBefore
          )
        ) &&
        xpSourceWasCreated(userId, event);
    }

    function visitMatches(userId, routeId, placeId) {
      let visit = get(
        /databases/$(database)/documents/visits/$(userId + '_' + placeId)
      ).data;

      return visit.userId == userId &&
        visit.routeId == routeId &&
        visit.placeId == placeId;
    }

    function validBaseRouteProof(proof) {
      return (
        proof.routeId == 'tecnologia' && proof.segment == 1 &&
        proof.placeIds == ['inatel', 'fai', 'ete', 'incubadora-municipal'] &&
        visitMatches(proof.userId, proof.routeId, 'inatel') &&
        visitMatches(proof.userId, proof.routeId, 'fai') &&
        visitMatches(proof.userId, proof.routeId, 'ete') &&
        visitMatches(proof.userId, proof.routeId, 'incubadora-municipal')
      ) || (
        proof.routeId == 'religiosa' && proof.segment == 1 &&
        proof.placeIds == [
          'capela-santa-luzia',
          'capela-santo-antonio',
          'sao-benedito',
          'igreja-batista-universitaria',
          'matriz-santa-rita',
          'igreja-presbiteriana',
          'pibave',
          'assembleia-de-deus-esperanca'
        ] &&
        visitMatches(proof.userId, proof.routeId, 'capela-santa-luzia') &&
        visitMatches(proof.userId, proof.routeId, 'capela-santo-antonio') &&
        visitMatches(proof.userId, proof.routeId, 'sao-benedito') &&
        visitMatches(proof.userId, proof.routeId, 'igreja-batista-universitaria') &&
        visitMatches(proof.userId, proof.routeId, 'matriz-santa-rita') &&
        visitMatches(proof.userId, proof.routeId, 'igreja-presbiteriana') &&
        visitMatches(proof.userId, proof.routeId, 'pibave') &&
        visitMatches(proof.userId, proof.routeId, 'assembleia-de-deus-esperanca')
      ) || (
        proof.routeId == 'cafe' && proof.segment == 1 &&
        proof.placeIds == [
          'moca-cafeteria',
          'grandpa-joels',
          'barao-cafeteria',
          'nano-coffee-lab',
          'melhor-da-terra-cafeteria'
        ] &&
        visitMatches(proof.userId, proof.routeId, 'moca-cafeteria') &&
        visitMatches(proof.userId, proof.routeId, 'grandpa-joels') &&
        visitMatches(proof.userId, proof.routeId, 'barao-cafeteria') &&
        visitMatches(proof.userId, proof.routeId, 'nano-coffee-lab') &&
        visitMatches(proof.userId, proof.routeId, 'melhor-da-terra-cafeteria')
      ) || (
        proof.routeId == 'gastronomia' && proof.segment == 1 &&
        proof.placeIds == [
          'braseiro',
          'brazza',
          'casa-do-pi',
          'restaurante-vista-alegre',
          'bragas-bistro',
          'armazem-do-vale',
          'hart-grill',
          'restaurante-do-dimas'
        ] &&
        visitMatches(proof.userId, proof.routeId, 'braseiro') &&
        visitMatches(proof.userId, proof.routeId, 'brazza') &&
        visitMatches(proof.userId, proof.routeId, 'casa-do-pi') &&
        visitMatches(proof.userId, proof.routeId, 'restaurante-vista-alegre') &&
        visitMatches(proof.userId, proof.routeId, 'bragas-bistro') &&
        visitMatches(proof.userId, proof.routeId, 'armazem-do-vale') &&
        visitMatches(proof.userId, proof.routeId, 'hart-grill') &&
        visitMatches(proof.userId, proof.routeId, 'restaurante-do-dimas')
      ) || (
        proof.routeId == 'gastronomia' && proof.segment == 2 &&
        proof.placeIds == [
          'casa-de-sinha',
          'restaurante-estancia',
          'elite-mineira',
          'dija-gastronomia',
          'mimmas'
        ] &&
        visitMatches(proof.userId, proof.routeId, 'casa-de-sinha') &&
        visitMatches(proof.userId, proof.routeId, 'restaurante-estancia') &&
        visitMatches(proof.userId, proof.routeId, 'elite-mineira') &&
        visitMatches(proof.userId, proof.routeId, 'dija-gastronomia') &&
        visitMatches(proof.userId, proof.routeId, 'mimmas')
      );
    }

    function validCustomRouteProof(proof) {
      let routeDocumentId = customRouteDocumentId(proof.routeId);
      let placeId = routeDocumentId + '-principal';

      return isCustomRouteId(proof.routeId) && proof.segment == 1 &&
        proof.placeIds == [placeId] &&
        validCustomRoutePlace(
          proof.routeId,
          placeId,
          get(/databases/$(database)/documents/routes/$(routeDocumentId)).data.nome
        ) &&
        visitMatches(proof.userId, proof.routeId, placeId);
    }

    function validRouteCompletionProof(userId, proofId) {
      let proof = request.resource.data;

      return proof.keys().hasAll([
          'kind',
          'userId',
          'routeId',
          'segment',
          'placeIds',
          'createdAt'
        ]) &&
        proof.keys().hasOnly([
          'kind',
          'userId',
          'routeId',
          'segment',
          'placeIds',
          'createdAt'
        ]) &&
        isOwner(userId) && proof.userId == userId &&
        proof.kind == 'routeCompletionProof' &&
        isNonEmptyString(proof.routeId, 64) &&
        proof.segment is int && proof.segment >= 1 && proof.segment <= 2 &&
        proof.placeIds is list && proof.placeIds.size() >= 1 &&
        proof.placeIds.size() <= 8 &&
        proofId == 'routeProof_' + proof.routeId + '_' + string(proof.segment) &&
        proof.createdAt == request.time &&
        (validBaseRouteProof(proof) || validCustomRouteProof(proof));
    }

    function routeProofWasCreated(userId, routeId, segment) {
      let proofId = 'routeProof_' + routeId + '_' + string(segment);
      let proofPath = /databases/$(database)/documents/ranking/$(userId)/xpEvents/$(proofId);

      return !exists(proofPath) && existsAfter(proofPath);
    }

    function validRouteCompletionProofs(userId, routeId) {
      return (
        routeId == 'gastronomia' &&
        routeProofWasCreated(userId, routeId, 1) &&
        routeProofWasCreated(userId, routeId, 2)
      ) || (
        (routeId in ['tecnologia', 'religiosa', 'cafe'] ||
          isCustomRouteId(routeId)) &&
        routeProofWasCreated(userId, routeId, 1)
      );
    }

    function validVisitCreate(visitId) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'userId',
          'placeId',
          'placeTitle',
          'routeId',
          'validatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'placeId',
          'placeTitle',
          'routeId',
          'validatedAt'
        ]) &&
        isOwner(data.userId) &&
        isNonEmptyString(data.placeId, 128) &&
        isNonEmptyString(data.placeTitle, 160) &&
        isNonEmptyString(data.routeId, 64) &&
        visitId == data.userId + '_' + data.placeId &&
        data.validatedAt == request.time &&
        validRoutePlace(data.routeId, data.placeId, data.placeTitle);
    }

    function validVisitUpdate(visitId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();

      return visitId == resource.data.userId + '_' + resource.data.placeId &&
        isOwner(resource.data.userId) &&
        data.userId == resource.data.userId &&
        data.placeId == resource.data.placeId &&
        data.placeTitle == resource.data.placeTitle &&
        data.routeId == resource.data.routeId &&
        data.validatedAt == request.time &&
        request.time >= resource.data.validatedAt + duration.value(24, 'h') &&
        changed.hasOnly(['validatedAt']);
    }

    function validRatingData(ratingId, data) {
      return data.keys().hasAll([
          'userId',
          'placeId',
          'placeTitle',
          'routeId',
          'rating',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'placeId',
          'placeTitle',
          'routeId',
          'rating',
          'createdAt',
          'updatedAt'
        ]) &&
        isOwner(data.userId) &&
        ratingId == data.userId + '_' + data.placeId &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.updatedAt == request.time &&
        validRoutePlace(data.routeId, data.placeId, data.placeTitle);
    }

    function validRatingCreate(ratingId) {
      let data = request.resource.data;

      return validRatingData(ratingId, data) &&
        data.keys().hasAll(['createdAt']) &&
        data.createdAt == request.time;
    }

    function validRatingUpdate(ratingId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let oldHasCreatedAt = resource.data.keys().hasAny(['createdAt']);
      let newHasCreatedAt = data.keys().hasAny(['createdAt']);

      return validRatingData(ratingId, data) &&
        data.userId == resource.data.userId &&
        data.placeId == resource.data.placeId &&
        data.placeTitle == resource.data.placeTitle &&
        data.routeId == resource.data.routeId &&
        oldHasCreatedAt == newHasCreatedAt &&
        (!oldHasCreatedAt || data.createdAt == resource.data.createdAt) &&
        changed.hasOnly(['rating', 'updatedAt']);
    }

    function validRewardCreate(rewardId) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'userId',
          'routeId',
          'routeName',
          'prize',
          'status',
          'earnedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'routeId',
          'routeName',
          'prize',
          'status',
          'earnedAt'
        ]) &&
        isOwner(data.userId) &&
        rewardId == data.userId + '_' + data.routeId &&
        isNonEmptyString(data.routeId, 64) &&
        isNonEmptyString(data.routeName, 160) &&
        isNonEmptyString(data.prize, 160) &&
        data.status == 'earned' &&
        data.earnedAt == request.time &&
        (validBaseRewardMetadata(data) || validCustomRewardMetadata(data)) &&
        validRouteCompletionProofs(data.userId, data.routeId);
    }

    function validRouteCategory(category) {
      return category in ['tecnologia', 'religioso', 'cafe', 'gastronomia', 'outro'];
    }

    function validCustomRouteData(routeId, data) {
      let pointId = routeId + '-principal';

      return routeId.matches('^[A-Za-z0-9]{20}$') &&
        data.keys().hasAll([
          'title',
          'category',
          'description',
          'nome',
          'cor',
          'premio',
          'createdBy',
          'createdAt',
          'updatedAt',
          'latitude',
          'longitude',
          'pontos'
        ]) &&
        data.keys().hasOnly([
          'title',
          'category',
          'description',
          'nome',
          'cor',
          'premio',
          'createdBy',
          'createdAt',
          'updatedAt',
          'latitude',
          'longitude',
          'pontos'
        ]) &&
        isNonEmptyString(data.nome, 160) && data.title == data.nome &&
        isNonEmptyString(data.description, 2000) &&
        validRouteCategory(data.category) &&
        data.cor is string && data.cor.matches('^#[0-9A-Fa-f]{6}$') &&
        isNonEmptyString(data.premio, 160) &&
        isNumber(data.latitude) && data.latitude >= -90 && data.latitude <= 90 &&
        isNumber(data.longitude) && data.longitude >= -180 && data.longitude <= 180 &&
        data.pontos is list && data.pontos.size() == 1 &&
        data.pontos[0] is map &&
        data.pontos[0].keys().hasAll([
          'id',
          'latitude',
          'longitude',
          'titulo',
          'tipo',
          'descricao',
          'imagem',
          'qrCode',
          'horarioAbertura',
          'horarioFechamento'
        ]) &&
        data.pontos[0].keys().hasOnly([
          'id',
          'latitude',
          'longitude',
          'titulo',
          'tipo',
          'descricao',
          'imagem',
          'qrCode',
          'horarioAbertura',
          'horarioFechamento'
        ]) &&
        data.pontos[0].id == pointId &&
        data.pontos[0].titulo == data.nome &&
        data.pontos[0].tipo == data.category &&
        data.pontos[0].descricao == data.description &&
        data.pontos[0].latitude == data.latitude &&
        data.pontos[0].longitude == data.longitude &&
        isNonEmptyString(data.pontos[0].imagem, 4096) &&
        data.pontos[0].qrCode == 'turismo:' + pointId &&
        data.pontos[0].horarioAbertura.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.pontos[0].horarioFechamento.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validEventBuilding(building) {
      return building in ['predio-2', 'predio-3', 'predio-4'];
    }

    function validEventFloor(building, floor) {
      return (
        building in ['predio-2', 'predio-3'] && floor == null
      ) || (
        building == 'predio-4' &&
        floor in ['terreo', 'primeiro-piso']
      );
    }

    function validEventTeamData(teamId, data) {
      return data.keys().hasAll([
          'id',
          'nome',
          'projeto',
          'descricao',
          'curso',
          'predio',
          'andar',
          'mesa',
          'x',
          'y',
          'qrPrefix',
          'ativo'
        ]) &&
        data.keys().hasOnly([
          'id',
          'nome',
          'projeto',
          'descricao',
          'curso',
          'predio',
          'andar',
          'mesa',
          'x',
          'y',
          'qrPrefix',
          'ativo'
        ]) &&
        data.id == teamId &&
        isNonEmptyString(data.nome, 120) &&
        isNonEmptyString(data.projeto, 200) &&
        isNonEmptyString(data.descricao, 2000) &&
        isNonEmptyString(data.curso, 160) &&
        isNonEmptyString(data.mesa, 30) &&
        validEventBuilding(data.predio) &&
        validEventFloor(data.predio, data.andar) &&
        isNumber(data.x) && data.x >= 0 && data.x <= 100 &&
        isNumber(data.y) && data.y >= 0 && data.y <= 100 &&
        data.qrPrefix is string &&
        data.qrPrefix.matches('^[A-Z0-9_-]{6,64}$') &&
        data.ativo is bool;
    }

    function validEventQrToken(teamId, data) {
      let team = get(
        /databases/$(database)/documents/eventTeams/$(teamId)
      ).data;

      return data.keys().hasAll(['teamId', 'token', 'updatedAt']) &&
        data.keys().hasOnly(['teamId', 'token', 'updatedAt']) &&
        data.teamId == teamId && team.id == teamId &&
        data.token is string &&
        data.token.matches(
          '^' + team.qrPrefix + '_[A-Za-z0-9_-]{16,128}$'
        ) &&
        data.updatedAt is timestamp;
    }

    function eventTeamIsActive(teamId) {
      let team = get(
        /databases/$(database)/documents/eventTeams/$(teamId)
      ).data;

      return team.id == teamId && team.ativo == true;
    }

    function validEventVisitProof(proofId) {
      let data = request.resource.data;
      let token = get(
        /databases/$(database)/documents/eventQrTokens/$(data.teamId)
      ).data;

      return data.keys().hasAll([
          'userId',
          'teamId',
          'qrToken',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'teamId',
          'qrToken',
          'createdAt'
        ]) &&
        isOwner(data.userId) &&
        isNonEmptyString(data.teamId, 128) &&
        proofId == data.userId + '_' + data.teamId &&
        data.qrToken is string && data.qrToken.size() <= 256 &&
        token.teamId == data.teamId &&
        token.token == data.qrToken &&
        data.createdAt == request.time &&
        eventTeamIsActive(data.teamId);
    }

    function eventVisitProofWasCreated(userId, teamId) {
      let proofId = userId + '_' + teamId;
      let proofPath = /databases/$(database)/documents/eventVisitProofs/$(proofId);
      let proof = getAfter(proofPath).data;

      return !exists(proofPath) &&
        proof.userId == userId && proof.teamId == teamId;
    }

    function validEventVisitCreate(visitId) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'userId',
          'teamId',
          'points',
          'visitedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'teamId',
          'points',
          'visitedAt'
        ]) &&
        isOwner(data.userId) &&
        isNonEmptyString(data.teamId, 128) &&
        visitId == data.userId + '_' + data.teamId &&
        data.points == 100 && data.visitedAt == request.time &&
        eventTeamIsActive(data.teamId) &&
        eventVisitProofWasCreated(data.userId, data.teamId);
    }

    function eventVisitWasCreated(userId, visitId) {
      let visitPath = /databases/$(database)/documents/eventVisits/$(visitId);
      let visit = getAfter(visitPath).data;

      return !exists(visitPath) &&
        visit.userId == userId && visitId == userId + '_' + visit.teamId &&
        visit.points == 100;
    }

    function validEventRankingIdentity(userId, data) {
      return isOwner(userId) && data.userId == userId &&
        isNonEmptyString(data.userName, 120) &&
        isOptionalEmail(data.userEmail) &&
        isOptionalPhotoUrl(data);
    }

    function validEventRankingCreate(userId) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'userId',
          'userName',
          'userEmail',
          'points',
          'teamsVisited',
          'lastVisitId',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'userName',
          'userEmail',
          'photoURL',
          'points',
          'teamsVisited',
          'lastVisitId',
          'updatedAt'
        ]) &&
        data.points == 100 && data.teamsVisited == 1 &&
        data.lastVisitId is string &&
        eventVisitWasCreated(userId, data.lastVisitId) &&
        data.updatedAt == request.time;
    }

    function validEventRankingScoreChange(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();

      return data.points is int && data.points >= 100 &&
        data.teamsVisited is int && data.teamsVisited >= 1 &&
        data.points == resource.data.get(
          'points',
          resource.data.get('teamsVisited', 0) * 100
        ) + 100 &&
        data.teamsVisited == resource.data.get('teamsVisited', 0) + 1 &&
        data.lastVisitId is string &&
        eventVisitWasCreated(userId, data.lastVisitId) &&
        data.updatedAt == request.time &&
        changed.hasOnly([
          'userId',
          'userName',
          'userEmail',
          'photoURL',
          'points',
          'teamsVisited',
          'lastVisitId',
          'updatedAt'
        ]);
    }

    function validEventRankingProfileChange() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();

      return data.userId == resource.data.userId &&
        isNonEmptyString(data.userName, 120) &&
        isOptionalEmail(data.userEmail) &&
        isOptionalPhotoUrl(data) &&
        data.updatedAt == request.time &&
        changed.hasOnly([
          'userId',
          'userName',
          'userEmail',
          'photoURL',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isProjectOwner();
      allow update, delete: if isOwner(userId);
    }

    match /ranking/{userId} {
      allow read: if signedIn();
      allow create: if validRankingIdentity(userId, request.resource.data) &&
        validRankingCreate(userId);
      allow update: if validRankingIdentity(userId, request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        (validRankingProfileChange() || validRankingScoreChange(userId));
      allow delete: if isProjectOwner() && userId == request.auth.uid;
    }

    match /ranking/{userId}/xpEvents/{eventId} {
      allow read: if isOwner(userId) || isProjectOwner();
      allow create: if validXpEvent(userId, eventId) ||
        validRouteCompletionProof(userId, eventId);
      allow update: if false;
      allow delete: if isProjectOwner() && userId == request.auth.uid;
    }

    match /visits/{visitId} {
      allow read: if signedIn() &&
        (visitId.matches('^' + request.auth.uid + '_.+$') || isProjectOwner());
      allow create: if validVisitCreate(visitId);
      allow update: if validVisitUpdate(visitId);
      allow delete: if isProjectOwner() &&
        resource.data.userId == request.auth.uid;
    }

    match /rewards/{rewardId} {
      allow read: if signedIn() &&
        (rewardId.matches('^' + request.auth.uid + '_.+$') || isProjectOwner());
      allow create: if validRewardCreate(rewardId);
      allow update: if false;
      allow delete: if isProjectOwner() &&
        resource.data.userId == request.auth.uid;
    }

    match /routes/{routeId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validCustomRouteData(routeId, request.resource.data);
      allow update: if signedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        validCustomRouteData(routeId, request.resource.data);
      allow delete: if signedIn() &&
        resource.data.createdBy == request.auth.uid;
    }

    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create: if validRatingCreate(ratingId);
      allow update: if validRatingUpdate(ratingId);
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /eventTeams/{teamId} {
      allow read: if signedIn();
      allow create, update: if isProjectOwner() &&
        validEventTeamData(teamId, request.resource.data);
      allow delete: if isProjectOwner();
    }

    match /eventQrTokens/{teamId} {
      allow read: if isProjectOwner();
      allow create, update: if isProjectOwner() &&
        validEventQrToken(teamId, request.resource.data);
      allow delete: if isProjectOwner();
    }

    match /eventVisitProofs/{proofId} {
      allow read: if isProjectOwner();
      allow create: if validEventVisitProof(proofId);
      allow update: if false;
      allow delete: if isProjectOwner();
    }

    match /eventVisits/{visitId} {
      allow read: if signedIn() &&
        (visitId.matches('^' + request.auth.uid + '_.+$') ||
          resource.data.userId == request.auth.uid || isProjectOwner());
      allow create: if validEventVisitCreate(visitId);
      allow update: if false;
      allow delete: if isProjectOwner();
    }

    match /eventRanking/{userId} {
      allow read: if signedIn();
      allow create: if validEventRankingIdentity(userId, request.resource.data) &&
        validEventRankingCreate(userId);
      allow update: if validEventRankingIdentity(userId, request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        (validEventRankingProfileChange() ||
          validEventRankingScoreChange(userId));
      allow delete: if isProjectOwner();
    }
  }
}
